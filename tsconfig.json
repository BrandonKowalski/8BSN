{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom"],
    "paths": {
      "@8bsn/sdk": ["./src/sdk/index.ts"],
      "@8bsn/sdk/core": ["./src/sdk/core.ts"],
      "@8bsn/sdk/testing": ["./src/sdk/testing.tsx"]
    }
  },
  "include": ["src", "packages", "tools", "*.ts"]
}
